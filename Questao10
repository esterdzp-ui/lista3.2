# EXERCÍCIO 10: Divisão de Itens
# Enunciado: Você tem 15 poções para dividir igualmente entre 3 jogadores. Use o operador / para mostrar quantas poções cada um recebe

# VARIÁVEIS
pocoes = 15
jogadores = 3

# PROCESSAMENTO
por_jogador = pocoes / jogadores

# SAÍDA
print(f"Cada jogador recebe: {por_jogador} poções")
